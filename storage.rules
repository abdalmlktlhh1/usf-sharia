rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return signedIn() && profile().data.active == true &&
        profile().data.role in [
          'owner', 'website_manager', 'scientific_college_manager',
          'scientific_college_deputy', 'media_manager', 'media_deputy'
        ];
    }

    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAdmin();
    }
  }
}
